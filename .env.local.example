# ── Supabase ─────────────────────────────────────────────────────────────────
# From your project's Settings → API. See README for project setup + migrations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Notion ───────────────────────────────────────────────────────────────────
# Internal integration token from notion.so/my-integrations.
# Your Second Brain root page must be shared with the integration.
NOTION_API_KEY=ntn_your-token
# The page ID of your root page (32-char id from its URL)
NOTION_ROOT_PAGE_ID=

# ── Anthropic (classification, synthesis, Q&A) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Voyage AI (embeddings for "ask your brain" semantic search) ──────────────
# Key from dash.voyageai.com
VOYAGE_API_KEY=pa-your-key
# Optional; must stay 1024-dim to match the entry_embeddings vector column
VOYAGE_MODEL=voyage-3.5-lite

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for backlinks from Notion rows).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# IANA timezone for the weekly synthesis dates, e.g. America/New_York.
# Optional and legacy: your timezone lives in the app now, under Settings.
# Only read while nothing has been saved there. Safe to leave blank.
APP_TIMEZONE=
# Shared secret protecting the /api/cron/* endpoints (set the same value in Vercel).
CRON_SECRET=generate-a-long-random-string

# Optional: one or two sentences about you, used by the weekly synthesis to
# organise "next actions" around your real clients/channels/projects, e.g.
# SYNTHESIS_CONTEXT=A freelance designer with clients Acme Co and Globex, plus a personal newsletter and YouTube channel.
# Recommended alternative: set this in-app on the Instructions page (Weekly
# synthesis) instead - an instruction there takes precedence over this var.
SYNTHESIS_CONTEXT=

# ── ClickUp (OPTIONAL - the "Work" capture pathway) ──────────────────────────
# Leave unset to hide the Work toggle entirely. Personal API token from
# ClickUp Settings → Apps → API Token. This is the only ClickUp env var you
# need: pick which lists work captures may be filed into on the app's Settings
# page, which takes effect immediately with no redeploy.
CLICKUP_API_TOKEN=

# Legacy fallback, only read while no lists have been saved in Settings. If you
# set this, Settings offers to import it once, after which you can delete it.
# CLICKUP_LISTS=[{"listId":"901234567","name":"Client Content","description":"Content pipeline for this client: ideas, posts, production tasks."}]
CLICKUP_LISTS=
